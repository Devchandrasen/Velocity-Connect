diff --git a/src/internet/test/ipv4-queue-disc-item-test-suite.cc b/src/internet/test/ipv4-queue-disc-item-test-suite.cc
new file mode 100644
index 000000000..a31de9c11
--- /dev/null
+++ b/src/internet/test/ipv4-queue-disc-item-test-suite.cc
@@ -0,0 +1,64 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0-only
+ */
+
+#include "ns3/ipv4-queue-disc-item.h"
+#include "ns3/packet.h"
+#include "ns3/test.h"
+
+using namespace ns3;
+
+namespace
+{
+
+class Ipv4QueueDiscShortTransportHeaderTestCase : public TestCase
+{
+  public:
+    Ipv4QueueDiscShortTransportHeaderTestCase()
+        : TestCase("Hash short TCP and UDP payloads without reading beyond the packet")
+    {
+    }
+
+  private:
+    void DoRun() override
+    {
+        ResetIpv4QueueDiscShortTransportHeaderHashEvents();
+
+        Ipv4Header udpHeader;
+        udpHeader.SetSource(Ipv4Address("10.0.0.1"));
+        udpHeader.SetDestination(Ipv4Address("10.0.0.2"));
+        udpHeader.SetProtocol(17);
+        udpHeader.SetPayloadSize(1032);
+        Ptr<Ipv4QueueDiscItem> udpItem =
+            Create<Ipv4QueueDiscItem>(Create<Packet>(7), Address(), 0x0800, udpHeader);
+        (void)udpItem->Hash(0);
+
+        Ipv4Header tcpHeader;
+        tcpHeader.SetSource(Ipv4Address("10.0.0.3"));
+        tcpHeader.SetDestination(Ipv4Address("10.0.0.4"));
+        tcpHeader.SetProtocol(6);
+        tcpHeader.SetPayloadSize(1032);
+        Ptr<Ipv4QueueDiscItem> tcpItem =
+            Create<Ipv4QueueDiscItem>(Create<Packet>(19), Address(), 0x0800, tcpHeader);
+        (void)tcpItem->Hash(0);
+
+        NS_TEST_ASSERT_MSG_EQ(
+            GetIpv4QueueDiscShortTransportHeaderHashEvents(),
+            2,
+            "Both short transport headers must be counted");
+    }
+};
+
+class Ipv4QueueDiscItemTestSuite : public TestSuite
+{
+  public:
+    Ipv4QueueDiscItemTestSuite()
+        : TestSuite("ipv4-queue-disc-short-transport-header", Type::UNIT)
+    {
+        AddTestCase(new Ipv4QueueDiscShortTransportHeaderTestCase(), Duration::QUICK);
+    }
+};
+
+static Ipv4QueueDiscItemTestSuite g_ipv4QueueDiscItemTestSuite;
+
+} // namespace
