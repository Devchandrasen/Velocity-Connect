# Hardware documents are local handoff artifacts.  The machine-readable VNA
# analyzer is explicitly retained as implementation source.
/hardware/*
!/hardware/analyze_vna_touchstone.py

# Python caches
__pycache__/
tmp/
*.py[cod]
.pytest_cache/
.venv-hfss/
.venv-reproduction/

# AEDT-generated project data
*.aedtresults/
*.aedt.lock
/hfss/results/
/hfss/*.pyaedt/
/hfss/*.log
/hfss/*.prof
/hfss/*.conv
/hfss/*.mstat
/hfss/*_manifest.json
/hfss/*LITERATURE*.md
/hfss/*HANDOFF*.md
/hfss/export_n78_paper_evidence.py

# Selected small native AEDT projects are staged explicitly.  Other local
# exploration projects remain ignored unless deliberately force-added.
/hfss/*.aedt

